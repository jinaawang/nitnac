        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:rose|pear|blue|sienna|card|crimson|outline)$/]",
        "message": "<Tag> color must be one of 'rose' | 'pear' | 'blue' | 'sienna' | 'card' | 'crimson' | 'outline'."
