        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='craft'] > Literal[value!=/^(?:sewing|crochet|knitting|mending)$/]",
        "message": "<Tag> craft must be one of 'sewing' | 'crochet' | 'knitting' | 'mending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:planning|in-progress|paused|finished)$/]",
        "message": "<Tag> status must be one of 'planning' | 'in-progress' | 'paused' | 'finished'."
