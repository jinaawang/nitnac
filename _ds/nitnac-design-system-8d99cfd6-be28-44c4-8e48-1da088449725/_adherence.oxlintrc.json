      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|owner|craft|status|backdrop|photo|stepsDone|stepsTotal|progress|nextStep|titleTone|stickerColor|liked|onLike|onOpen|actions|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: title, owner, craft, status, backdrop, photo, stepsDone, stepsTotal, progress, nextStep, titleTone, stickerColor, liked, onLike, onOpen, actions, assetBase, style."
