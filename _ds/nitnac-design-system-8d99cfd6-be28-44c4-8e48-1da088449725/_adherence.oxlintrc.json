      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute[name.name='stickerColor'] > Literal[value!=/^(?:sienna|rose|pear|blue)$/]",
        "message": "<ProjectCard> stickerColor must be one of 'sienna' | 'rose' | 'pear' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Scallop'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|aspect|children|style|key|ref|className|style|children)$/]",
        "message": "<Scallop> doesn't accept that prop. Declared props: color, aspect, children, style."
      },
