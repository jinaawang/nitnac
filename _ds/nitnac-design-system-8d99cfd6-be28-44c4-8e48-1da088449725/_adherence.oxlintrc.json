{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/lists/**",
              "components/navigation/**",
              "components/people/**",
              "components/progress/**",
              "components/shapes/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Winksy|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Winksy, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|color|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, initials, color, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:rose|pear|blue|sienna)$/]",
        "message": "<Avatar> color must be one of 'rose' | 'pear' | 'blue' | 'sienna'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:people|max|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<AvatarGroup> doesn't accept that prop. Declared props: people, max, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|size|icon|iconRight|fullWidth|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, color, size, icon, iconRight, fullWidth, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|soft)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:rose|pear|blue)$/]",
        "message": "<Button> color must be one of 'rose' | 'pear' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|selected|today|onChange|multiple|size|style|key|ref|className|style|children)$/]",
        "message": "<DayPicker> doesn't accept that prop. Declared props: days, selected, today, onChange, multiple, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|dot|size|selected|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, dot, size, selected, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:card|ink|outline)$/]",
        "message": "<IconButton> variant must be one of 'card' | 'ink' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IllustratedIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:craft|name|tint|size|assetBase|label|style|key|ref|className|style|children)$/]",
        "message": "<IllustratedIcon> doesn't accept that prop. Declared props: craft, name, tint, size, assetBase, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IllustratedIcon'] > JSXAttribute[name.name='craft'] > Literal[value!=/^(?:sewing|crochet|knitting|mending)$/]",
        "message": "<IllustratedIcon> craft must be one of 'sewing' | 'crochet' | 'knitting' | 'mending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IllustratedIcon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:sewing-machine|scissors|spool|iron|pins|pin-cushion|bow|yarn-hook|yarn-basket)$/]",
        "message": "<IllustratedIcon> name must be one of 'sewing-machine' | 'scissors' | 'spool' | 'iron' | 'pins' | 'pin-cushion' | 'bow' | 'yarn-hook' | 'yarn-basket'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IllustratedIcon'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:rose|pear|blue|sienna|card|none)$/]",
        "message": "<IllustratedIcon> tint must be one of 'rose' | 'pear' | 'blue' | 'sienna' | 'card' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|multiline|rows|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, multiline, rows, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|color|children|style|key|ref|className|style|children)$/]",
        "message": "<ListPanel> doesn't accept that prop. Declared props: title, action, color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListPanel'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:rose|pear|blue)$/]",
        "message": "<ListPanel> color must be one of 'rose' | 'pear' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|leading|trailing|chevron|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, subtitle, icon, leading, trailing, chevron, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|total|color|label|showLabel|track|height|cheer|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, total, color, label, showLabel, track, height, cheer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='track'] > Literal[value!=/^(?:page|card)$/]",
        "message": "<ProgressBar> track must be one of 'page' | 'card'."
